# Copy this to .env (same directory as docker-compose.yml) and fill in real values.
# docker-compose automatically reads a file named .env in this directory.

# Copy this to .env (same directory as docker-compose.yml) and fill in real values.
# docker-compose automatically reads a file named .env in this directory.

JWT_SECRET=replace-with-a-long-random-value
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Set to "seed" to insert mock data on startup (see README's "Seeding mock data" section).
# Leave blank for a clean database.
SPRING_PROFILES_ACTIVE=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CUSTOMER_SUBDOMAIN=
